// ---------- game logic ----------

local fn StepX( x as long, d as long ) as long
  if d > 0
    if x < _sprXMax
      x = x + gSpeed
    else
      x = _sprXMax
    end if
  end if
  if d < 0
    if x >= _sprXMin + 1
      x = x - gSpeed
    else
      x = _sprXMin
    end if
  end if
end fn = x

local fn StepY( y as long, d as long ) as long
  if d > 0
    if y <= _sprYMax then y = y + gSpeed
  end if
  if d < 0
    if y > _sprYMin then y = y - gSpeed
  end if
end fn = y

local fn HitTest as long
  // the crosshair pixels must overlap the saucer pixels, as on the C64
  dim as long hit, r, c, ex, ox, oy, px, py
  hit = 0
  ex = 2
  if gSightSmall then ex = 1
  for r = 0 to 20
    for c = 0 to 23
      if gCross(r, c)
        for oy = 0 to ex - 1
          for ox = 0 to ex - 1
            px = gSightX + c * ex + ox - gSaucX
            py = gSightY + r * ex + oy - gSaucY
            if px >= 0 && px <= 23 && py >= 0 && py <= 20
              if gSpr(_frSaucer, py, px >> 1) then hit = 1
            end if
          next
        next
      end if
    next
  next
end fn = hit

void local fn StartGame( players as long )
  gPlayers = players
  gScore = 0
  gSightX = _startPos : gSightY = _startPos
  gSaucX = _startPos : gSaucY = _startPos
  gWave = _wavesToWin
  gHP = _hitsPerWave
  gDoom = _doomTicks
  gGate = _fireGate
  gArmed = 0 : gFlash = 0 : gExplode = 0 : gSightSmall = 0
  gDirT = 1 : gAdx = 0 : gAdy = 0
  gEarthFrame = _frEarth1
  fn BuildBackdrop
  gState = _stPlay
  sound stop 1
  sound 1,, gSndSiren, 0.3, YES
end fn

void local fn WinGame
  gState = _stWon
  gFlash = 0
  sound stop 1
end fn

void local fn LoseGame
  gState = _stBoom
  gBoomTick = 0
  gFlash = 0
  sound stop 1
  sound 4,, gSndBoom, 0.8, NO
end fn

void local fn PickSaucerMove
  // the eight joystick moves the original chose from at random
  select ( rnd(0, 7) )
    case 0 : gAdx = 0  : gAdy = -1
    case 1 : gAdx = 0  : gAdy = 1
    case 2 : gAdx = -1 : gAdy = 0
    case 3 : gAdx = -1 : gAdy = -1
    case 4 : gAdx = -1 : gAdy = 1
    case 5 : gAdx = 1  : gAdy = 0
    case 6 : gAdx = 1  : gAdy = -1
    case 7 : gAdx = 1  : gAdy = 1
  end select
end fn

void local fn StepPlay
  dim as long dx, dy
  // gunsight
  dx = 0 : dy = 0
  if gKLeft then dx = -1
  if gKRight then dx = 1
  if gKUp then dy = -1
  if gKDown then dy = 1
  gSightX = fn StepX( gSightX, dx )
  gSightY = fn StepY( gSightY, dy )
  // saucer
  if gPlayers = 2
    dx = 0 : dy = 0
    if gKA then dx = -1
    if gKD then dx = 1
    if gKW then dy = -1
    if gKS then dy = 1
    gSightSmall = gJamHeld
  else
    gDirT = gDirT - 1
    if gDirT <= 0
      fn PickSaucerMove
      gDirT = gWave
    end if
    dx = gAdx : dy = gAdy
    gSightSmall = 0
  end if
  gSaucX = fn StepX( gSaucX, dx )
  gSaucY = fn StepY( gSaucY, dy )
  // trigger, checked on the same gate the original used
  gGate = gGate - 1
  if gGate <= 0
    gGate = _fireGate
    gFlash = 0
    if gFireHeld = 0
      gExplode = 0
      gArmed = 1
    else
      if gArmed
        gArmed = 0
        sound stop 2
        sound 2,, gSndShot, 0.5, NO
        if fn HitTest
          gScore = gScore + _pointsPerHit
          gDoom = _doomTicks
          gFlash = 1
          gExplode = 1
          gGate = _hitPause
          sound stop 3
          sound 3,, gSndWhoop, 0.6, NO
          gHP = gHP - 1
          if gHP <= 0
            gHP = _hitsPerWave
            gWave = gWave - 1
            if gWave < _winBelow then fn WinGame
          end if
        end if
      end if
    end if
  end if
  // the hidden clock: land a hit or the Earth dies
  if gState = _stPlay
    gDoom = gDoom - 1
    if gDoom <= 0 then fn LoseGame
  end if
end fn

void local fn StepBoom
  gBoomTick = gBoomTick + 1
  gEarthFrame = _frEarth1 + (gBoomTick / 10) mod 3
  if gBoomTick >= _boomTicks
    gEarthFrame = _frEarth3
    gState = _stLost
  end if
end fn

void local fn GameTick
  if gClosing then exit fn
  gTick = gTick + 1
  if gState = _stPlay
    fn StepPlay
    if gTick mod _anim4 = 0 then fn StepBackdrop
  end if
  if gState = _stBoom then fn StepBoom
  ViewSetNeedsDisplay( _gameView )
end fn
