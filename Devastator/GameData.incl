// ---------- data loading ----------

void local fn InitData
  dim as long i, f, r, b, c, v, p
  // palette
  for i = 0 to 15
    read v : gPalR(i) = v / 255.0
    read v : gPalG(i) = v / 255.0
    read v : gPalB(i) = v / 255.0
  next
  // saucer, multicolor pair codes
  for r = 0 to 20
    for b = 0 to 2
      read v
      for p = 0 to 3
        gSpr(_frSaucer, r, b * 4 + p) = (v >> (6 - p * 2)) and 3
      next
    next
  next
  // crosshair and box, mono bits
  for r = 0 to 20
    for b = 0 to 2
      read v
      for c = 0 to 7
        gCross(r, b * 8 + c) = (v >> (7 - c)) and 1
      next
    next
  next
  for r = 0 to 20
    for b = 0 to 2
      read v
      for c = 0 to 7
        gBox(r, b * 8 + c) = (v >> (7 - c)) and 1
      next
    next
  next
  // earth frames, multicolor pair codes
  for f = _frEarth1 to _frEarth3
    for r = 0 to 20
      for b = 0 to 2
        read v
        for p = 0 to 3
          gSpr(f, r, b * 4 + p) = (v >> (6 - p * 2)) and 3
        next
      next
    next
  next
  // font: A-Z, 0-9, . , ' : - ! ? /
  for i = 0 to 43
    for r = 0 to 6
      read v : gFont(i, r) = v
    next
  next
end fn
