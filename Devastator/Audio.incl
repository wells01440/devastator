// ---------- sound ----------

void local fn PutH32( ofs as long, v as long )
  gHdr(ofs) = v and 255
  gHdr(ofs + 1) = (v >> 8) and 255
  gHdr(ofs + 2) = (v >> 16) and 255
  gHdr(ofs + 3) = (v >> 24) and 255
end fn

local fn WavFromScratch( count as long ) as CFDataRef
  // 22050 Hz 16 bit mono PCM
  dim as CFMutableDataRef d
  dim as long n
  n = count * 2
  gHdr(0) = 82 : gHdr(1) = 73 : gHdr(2) = 70 : gHdr(3) = 70
  fn PutH32( 4, 36 + n )
  gHdr(8) = 87 : gHdr(9) = 65 : gHdr(10) = 86 : gHdr(11) = 69
  gHdr(12) = 102 : gHdr(13) = 109 : gHdr(14) = 116 : gHdr(15) = 32
  fn PutH32( 16, 16 )
  gHdr(20) = 1 : gHdr(21) = 0 : gHdr(22) = 1 : gHdr(23) = 0
  fn PutH32( 24, 22050 )
  fn PutH32( 28, 44100 )
  gHdr(32) = 2 : gHdr(33) = 0 : gHdr(34) = 16 : gHdr(35) = 0
  gHdr(36) = 100 : gHdr(37) = 97 : gHdr(38) = 116 : gHdr(39) = 97
  fn PutH32( 40, n )
  d = fn MutableDataNew
  MutableDataAppendBytes( d, @gHdr(0), 44 )
  MutableDataAppendBytes( d, @gSamp(0), n )
end fn = d

void local fn BuildSounds
  dim as long i, n
  dim as double ph, f, tri, amp, q, lp, r
  // saucer drone: seamless sawtooth warble loop
  n = 11025
  ph = 0.0
  for i = 0 to n - 1
    tri = i / (n - 1.0)
    if tri > 0.5 then tri = 1.0 - tri
    f = 445.0 + 90.0 * tri
    ph = ph + f / 22050.0
    if ph >= 1.0 then ph = ph - 1.0
    amp = 4500.0
    if i < 200 then amp = amp * i / 200.0
    if i > n - 200 then amp = amp * (n - i) / 200.0
    gSamp(i) = (ph * 2.0 - 1.0) * amp
  next
  gSndSiren = fn WavFromScratch( n )
  fn CFRetain( gSndSiren )
  // shot: falling square blip
  n = 2646
  ph = 0.0
  for i = 0 to n - 1
    f = 900.0 - 600.0 * i / n
    ph = ph + f / 22050.0
    if ph >= 1.0 then ph = ph - 1.0
    amp = 7500.0 * (n - i) / n
    if ph < 0.5
      gSamp(i) = amp
    else
      gSamp(i) = -amp
    end if
  next
  gSndShot = fn WavFromScratch( n )
  fn CFRetain( gSndShot )
  // hit: falling sawtooth whoop
  n = 8820
  ph = 0.0
  for i = 0 to n - 1
    f = 760.0 - 320.0 * i / n
    ph = ph + f / 22050.0
    if ph >= 1.0 then ph = ph - 1.0
    amp = 7500.0 * (1.0 - 0.5 * i / n)
    gSamp(i) = (ph * 2.0 - 1.0) * amp
  next
  gSndWhoop = fn WavFromScratch( n )
  fn CFRetain( gSndWhoop )
  // earth explosion: decaying filtered noise
  n = 39690
  lp = 0.0
  for i = 0 to n - 1
    r = rnd(0, 16000) - 8000
    lp = lp * 0.82 + r * 0.18
    q = 1.0 - i / (n * 1.0)
    gSamp(i) = lp * q * q * 1.6
  next
  gSndBoom = fn WavFromScratch( n )
  fn CFRetain( gSndBoom )
end fn
